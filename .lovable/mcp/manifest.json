{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://dmarkaigzovaqwpigtxe.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "lost-and-find",
      "version": "0.1.0",
      "title": "lost-and-find"
    },
    "tools": [
      {
        "name": "search_items",
        "title": "Search lost & found items",
        "description": "Search active lost or found item reports by keyword, category, location, or type.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Keyword to match in title or description."
            },
            "item_type": {
              "type": "string",
              "enum": [
                "lost",
                "found"
              ],
              "description": "Restrict to lost or found reports."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "Item category, e.g. Electronics."
            },
            "location": {
              "type": "string",
              "minLength": 1,
              "description": "Partial location text to match."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Maximum number of results."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_item",
        "title": "Get item details",
        "description": "Fetch the full details of a single lost or found item report by its ID.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "The item ID."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_items",
        "title": "List my reports",
        "description": "List the lost and found item reports created by the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "active",
                "resolved",
                "closed"
              ],
              "description": "Filter by report status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum number of results."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "report_item",
        "title": "Report a lost or found item",
        "description": "Create a new lost or found item report for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Short title of the item."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Detailed description of the item."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "Item category, e.g. Electronics."
            },
            "item_type": {
              "type": "string",
              "enum": [
                "lost",
                "found"
              ],
              "description": "Whether the item was lost or found."
            },
            "location": {
              "type": "string",
              "minLength": 1,
              "description": "Where the item was lost or found."
            },
            "date_lost_found": {
              "type": "string",
              "minLength": 1,
              "description": "Date it was lost or found (YYYY-MM-DD)."
            },
            "contact_name": {
              "type": "string",
              "minLength": 1,
              "description": "Contact name for this report."
            },
            "contact_email": {
              "type": "string",
              "format": "email",
              "description": "Contact email for this report."
            },
            "contact_phone": {
              "type": "string",
              "minLength": 1,
              "description": "Contact phone for this report."
            },
            "reward": {
              "type": "string",
              "minLength": 1,
              "description": "Optional reward offered."
            },
            "additional_info": {
              "type": "string",
              "minLength": 1,
              "description": "Any extra details."
            }
          },
          "required": [
            "title",
            "description",
            "category",
            "item_type",
            "location",
            "date_lost_found",
            "contact_name",
            "contact_email",
            "contact_phone"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
